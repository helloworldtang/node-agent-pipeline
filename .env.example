# ===== LLM（三选一：deepseek / moonshot / custom）=====
# deepseek：默认，baseURL https://api.deepseek.com/v1
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-你的deepseek-key

# moonshot（Kimi 开放平台按量付费，platform.moonshot.cn 充值后创建 key）：
# LLM_PROVIDER=moonshot
# LLM_API_KEY=sk-你的moonshot-key

# custom（任意 OpenAI 兼容服务，须显式给出 baseURL 和模型名）：
# LLM_PROVIDER=custom
# LLM_API_KEY=xxx
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_MODEL_FLASH=your-fast-model
# LLM_MODEL_PRO=your-strong-model

# 可选：覆盖默认模型名
# LLM_MODEL_FLASH=deepseek-v4-flash
# LLM_MODEL_PRO=deepseek-v4-pro

# ===== 可选：通用 MCP 素材服务（不配则不启用，完全不影响使用）=====
# 与本地 materials/ 素材可同时启用（本地素材注入初始 prompt，MCP 工具按需检索）
# MCP_COMMAND=your-mcp-server-command
# MCP_ARGS=serve
# 例（接回 ExoMind 知识库检索取材，需已 exomind login）：
# MCP_COMMAND=exomind
# MCP_ARGS=mcp

# ===== 校验循环（都有默认值，可不改）=====
# MIN_ARTICLE_LEN=600
# REQUIRED_SECTIONS=            # 逗号分隔多个必需小节标题，空=不强制结构
# MAX_RETRIES=2
# FORCE_FIRST_REFINE=0          # 1=首轮无条件打回精修一次（演示用）
# MAX_MATERIAL_CHARS=12000      # 初始 prompt 最多注入多少素材字符，超出部分由 Agent 按需读取
# REQUIRE_SUMMARY=0             # 1=要求正文出现“摘要/导语/本文要点”标记
# REQUIRE_CITATIONS=0           # 1=事实性表述需带链接或来源标记
# SENSITIVE_WORDS=              # 逗号分隔的敏感词，命中时运行状态降级

# ===== 素材与文章索引（均有默认路径）=====
# MATERIALS_DIR=materials
# ARTICLE_DB_FILE=output/articles.sqlite
# AUTO_LOAD_MATERIALS=1       # CLI 是否自动加载 materials/；Web 只使用本次显式输入

# ===== 网络请求与 Web API 安全 =====
# HTTP_TIMEOUT_MS=120000
# HTTP_RETRIES=2
# API_MAX_BODY_BYTES=16777216   # JSON 请求上限；图片原始流另按 10MB 限制
# MAX_CONCURRENT_RUNS=1
# API_TOKEN=                    # 配置后本机 API 也要求 Bearer Token；远程监听时必填
# 远程 Web 前端另在 web/.env 配置：VITE_API_TOKEN=同一个值

# ===== 发布（也可以优先使用 CLI 参数 --platform / --publish / --cover）=====
# PUBLISH_PLATFORM=wechat         # wechat=官方API直连(默认) / exomind=经ExoMind服务端 / 逗号分隔=两条链路都投
# PUBLISH_ACCOUNT=你的公众号配置名称
# PUBLISH_COVER=covers/default.png

# ===== Web 服务端口（均有默认值）=====
# HOST=127.0.0.1
# PORT=7302
# VITE_WEB_PORT=7101
# VITE_API_PORT=7302

# ===== 公众号账号配置文件路径（默认 config/accounts.json）=====
# WECHAT_ACCOUNTS_FILE=config/accounts.json

# ===== 可选：AI 生图（用于界面上的「AI 生成封面」，OpenAI 兼容协议，四选一）=====
# 阿里百炼·通义万相（国内直连，按张计费，便宜）：
# IMAGE_API_KEY=sk-你的dashscope-key
# IMAGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# IMAGE_MODEL=wanx2.1-t2i-turbo
# IMAGE_SIZE=1024*1024
#
# 火山方舟·豆包 Seedream：
# IMAGE_API_KEY=你的ark-key
# IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# IMAGE_MODEL=doubao-seedream-4-0-250828
# IMAGE_SIZE=1024x1024
#
# 智谱 CogView：
# IMAGE_API_KEY=你的智谱-key
# IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# IMAGE_MODEL=cogview-3-plus
#
# OpenAI（需海外网络）：
# IMAGE_API_KEY=sk-你的openai-key
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024

# 封面生图提示词模板（{description} 是占位符，生成时由 LLM 读文章内容自动填充；
# 不写则用内置默认：2.35:1 宽幅构图 + 中央 1:1 安全区 + 无文字扁平编辑插画风格）
# IMAGE_COVER_PROMPT=你的自定义模板，记得保留 {description} 占位符
